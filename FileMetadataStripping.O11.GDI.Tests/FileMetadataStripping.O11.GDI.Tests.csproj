<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Distinct root namespace so the local `FileMetadataStripping` adapter type
         in this project's TestHelpers.cs does NOT collide with the same-named
         type in FileMetadataStripping.O11.Tests. Test files declare their own
         `namespace FileMetadataStripping.Tests;` — this is a different assembly
         so no conflict at runtime. -->
    <RootNamespace>FileMetadataStripping.Tests.Gdi</RootNamespace>
    <AssemblyName>FileMetadataStripping.O11.GDI.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="OpenMcdf" Version="3.1.4" />
    <PackageReference Include="OpenMcdf.Ole" Version="3.1.4-experimental.1" />
    <PackageReference Include="PDFsharp" Version="1.50.5147" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileMetadataStripping.O11\FileMetadataStripping.O11.csproj" />
  </ItemGroup>

  <!-- Share the per-format test-data generators AND the pure-managed pipeline
       tests (Documents, Media, Passthrough, SVG, DIB) with the primary O11
       test project. Those pipelines never touch Magick.NET, so behaviour is
       identical on both engines and there is a single source of truth. -->
  <ItemGroup>
    <Compile Include="..\FileMetadataStripping.O11.Tests\TestHelpers.Images.cs" Link="TestHelpers.Images.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\TestHelpers.Documents.Epub.cs" Link="TestHelpers.Documents.Epub.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\TestHelpers.Documents.LegacyOffice.cs" Link="TestHelpers.Documents.LegacyOffice.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\TestHelpers.Documents.Odf.cs" Link="TestHelpers.Documents.Odf.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\TestHelpers.Documents.OpenXml.cs" Link="TestHelpers.Documents.OpenXml.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\TestHelpers.Documents.Ora.cs" Link="TestHelpers.Documents.Ora.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\TestHelpers.Documents.Pdf.cs" Link="TestHelpers.Documents.Pdf.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\TestHelpers.Documents.Rtf.cs" Link="TestHelpers.Documents.Rtf.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\TestHelpers.Media.cs" Link="TestHelpers.Media.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Documents, Media, Passthrough — pure managed pipelines, identical behaviour. -->
    <Compile Include="..\FileMetadataStripping.O11.Tests\Documents\**\*.cs" LinkBase="Documents" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\Media\**\*.cs" LinkBase="Media" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\Passthrough\**\*.cs" LinkBase="Passthrough" />
  </ItemGroup>

  <ItemGroup>
    <!-- Images that behave identically on both engines:
         SVG      — pure managed XML cleaner (never routed to Magick.NET).
         DIB/WBMP — DetectCategory returns Passthrough (never routed to any strip engine).
         MSVG/AI  — routed to SVG (XML) / PDF path via DetectCategory. -->
    <Compile Include="..\FileMetadataStripping.O11.Tests\Images\SvgImageTests.cs" Link="Images\SvgImageTests.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\Images\DibImageTests.cs" Link="Images\DibImageTests.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\Images\WbmpImageTests.cs" Link="Images\WbmpImageTests.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\Images\MsvgImageTests.cs" Link="Images\MsvgImageTests.cs" />
    <Compile Include="..\FileMetadataStripping.O11.Tests\Images\AiImageTests.cs" Link="Images\AiImageTests.cs" />
  </ItemGroup>

  <!-- Every other Images/*Tests.cs is NOT linked. Under GDI+ they either:
         · exercise a format that GDI+ CAN decode (JPEG, PNG, GIF, BMP, TIFF)
           → covered by Images/GdiSupportedFormatTests.cs (this project),
         · exercise a recognised-but-GDI+-unsupported format (WebP, HEIC, JXL, …)
           → covered by Images/GdiUnsupportedFormatTests.cs (this project),
         · exercise an unrecognised passthrough (WBMP, some camera RAWs)
           → covered by the shared WbmpImageTests link above. -->

</Project>
